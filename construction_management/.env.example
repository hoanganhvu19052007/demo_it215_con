# .env.example — sample environment variables for development
# Copy this file to .env and fill real values. DO NOT commit your .env with secrets.

# For a quick local dev using SQLite (no external DB required)
# Uncomment the sqlite line and comment mysql line if you prefer sqlite
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Example for MySQL:
# DATABASE_URL=mysql+pymysql://dbuser:dbpass@localhost:3306/dbname

# JWT / security
SECRET_KEY=change_this_to_a_secure_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
DEBUG=True
